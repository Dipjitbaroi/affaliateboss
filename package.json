{
  "name": "affiliate-boss",
  "version": "4.0.0",
  "description": "Complete Affiliate Marketing Platform - PostgreSQL + Prisma + Express Edition",
  "main": "server/api.js",
  "scripts": {
    "dev": "node start.js",
    "dev:manual": "echo \"Open 2 terminals: 'npm run api' and 'npm run frontend'\"",
    "api": "cross-env API_PORT=3002 node server/api.js",
    "frontend": "vite --port 3000 --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run dev",
    "test": "curl http://localhost:3000/api/health",
    "test-api": "curl http://localhost:3002/api/health",
    "setup": "node scripts/setup-postgresql.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node scripts/prisma-seed.js",
    "db:reset": "prisma migrate reset",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.20.1",
    "pg": "^8.11.3",
    "twilio": "^4.19.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "prisma": "^5.7.1",
    "vite": "^5.4.19"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "affiliate-marketing",
    "postgresql",
    "prisma",
    "vite",
    "express",
    "nodejs",
    "shopify",
    "sms",
    "ai",
    "full-stack",
    "production"
  ],
  "author": "Bangladesh Dev Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/username/affiliate-boss-vercel"
  }
}
